  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MoonCinematic.CinematicSequenceController
  director: {fileID: 1591033475}
  uiCanvas: {fileID: 1501153993}
  storyText: {fileID: 2099391494}
  fadeOverlay: {fileID: 894937693}
  topBar: {fileID: 1178812610}
  bottomBar: {fileID: 1191353664}
  ambienceSource: {fileID: 1457017716}
  fadeInDuration: 2.2
  fadeOutStart: 43.4
  fadeOutDuration: 1.6
  letterSpacing: 0
  lineFade: 0.8
  endCardTitle: {fileID: 2124878489}
  endCardSub: {fileID: 1756636668}
  endCardStart: 45.8
  endCardFadeDuration: 1.6
  endCardHoldDuration: 6.5
  endCardTitleText: THE LUNAR
  endCardSubText: WELCOME, ASTRONAUT. YOUR LUNAR JOURNEY BEGINS NOW.
  lines:
  - text: The mission was supposed to be routine.
    startTime: 1.6
    endTime: 8.4
  - text: You and your team were sent to the Moon to collect samples for scientific
      research.
    startTime: 8.6
    endTime: 15
  - text: But during the journey, a critical failure caused the spacecraft to lose
      control.
    startTime: 15.2
    endTime: 21.2
  - text: The spacecraft crashed into the Moon.
    startTime: 21.4
    endTime: 28.2
  - text: Your teammates didn't survive.
    startTime: 28.4
    endTime: 34.4
  - text: You are the only one left alive.
    startTime: 34.6
    endTime: 39.4
  - text: Stranded on the surface of the Moon, with a damaged spacecraft and limited
      resources, you must find a way to survive.
    startTime: 39.6
    endTime: 45
